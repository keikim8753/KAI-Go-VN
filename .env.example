# 부록 B·11.5절 참조 — 실제 값은 절대 커밋하지 말 것 (.env는 .gitignore에 포함되어 있어야 함)

# Google Sheets/Drive API (필수 — 부록 B 항목 1~4)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account", "...":"..."}
MASTER_SHEET_ID=
SURVEY_SHEET_ID=
DRIVE_ROOT_FOLDER_ID=

# LLM 기반 바이어 마스킹 참고용 제안 (3.2절 — 선택, 부록 B 항목 10-1)
# 기본 설계는 담당자가 target_buyer_display를 직접 입력하므로 이 키 없이도 전체 파이프라인이 동작한다.
LLM_API_KEY=

# 기계번역 (선택 — 8장)
TRANSLATE_API_KEY=

# 호스팅 배포 토큰 (선택 — 11.5절)
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
