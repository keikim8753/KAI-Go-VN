---
import type { Locale } from '../lib/i18n';
import type { PublicCompany } from '../lib/companies';
import { sdgLabel } from '../lib/sdgs';

interface Props {
  locale: Locale;
  company: PublicCompany;
}

const { locale, company } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstMetric = company.key_metrics?.[0];
---

<a class="glass-card company-card" href={`${base}/${locale}/company/${company.company_id}`}>
  {company.logo_image && (
    <img class="logo" src={company.logo_image} alt={`${company.name} logo`} loading="lazy" />
  )}
  <div class="body">
    <h3>{company.name}</h3>
    <p class="tagline">{company.tagline}</p>
    {firstMetric && (
      <p class="tagline"><strong style="color: var(--accent)">{firstMetric.value}</strong> {firstMetric.label}</p>
    )}
    <div class="card-badges">
      {company.events?.map((e) => <span class="badge">{e.name}</span>)}
      {company.sdgs?.slice(0, 3).map((n) => <span class="badge">SDG {n} · {sdgLabel(n, locale)}</span>)}
    </div>
  </div>
</a>
