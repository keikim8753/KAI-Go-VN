---
import type { Locale } from '../lib/i18n';
import type { PublicCompany } from '../lib/companies';
import { sectorLabel, type Sector } from '../lib/sectors';

interface Props {
  locale: Locale;
  company: PublicCompany;
}

const { locale, company } = Astro.props;
---

<a class="company-card" href={`/${locale}/company/${company.company_id}`}>
  {company.logo_image && (
    <img class="logo" src={company.logo_image} alt={`${company.name} logo`} loading="lazy" />
  )}
  <div class="body">
    <h3>{company.name}</h3>
    <p class="sector">{sectorLabel(company.sector as Sector, locale)}</p>
    <p class="tagline">{company.tagline}</p>
    <span class="tag">{company.business_model}</span>
  </div>
</a>

<style>
  .company-card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid #e5e5ea;
    border-radius: 12px;
    background: #fff;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s ease;
  }
  .company-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }
  .logo {
    width: 56px;
    height: 56px;
    object-fit: contain;
    border-radius: 8px;
    background: #f2f2f7;
    flex-shrink: 0;
  }
  h3 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }
  .sector {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    color: #6b6b7a;
  }
  .tagline {
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    color: #3a3a4a;
  }
  .tag {
    display: inline-block;
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: #eef1ff;
    color: #2452ff;
  }
</style>
