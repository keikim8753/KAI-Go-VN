---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyCard from '../CompanyCard.astro';
import { t, type Locale } from '../../lib/i18n';
import { sectorLabel, type Sector } from '../../lib/sectors';
import { getPublicCompaniesBySector } from '../../lib/companies';

interface Props {
  locale: Locale;
  sector: Sector;
}

const { locale, sector } = Astro.props;
const companies = await getPublicCompaniesBySector(locale, sector);
const label = sectorLabel(sector, locale);
---

<BaseLayout locale={locale} title={label} currentPath={`/sector/${sector}`}>
  <h1>{label}</h1>
  <div class="grid">
    {companies.map((company) => (
      <CompanyCard locale={locale} company={company} />
    ))}
  </div>
  {companies.length === 0 && <p>{t(locale, 'directory_no_results')}</p>}

  <style>
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1rem;
      margin-top: 1.5rem;
    }
  </style>
</BaseLayout>
