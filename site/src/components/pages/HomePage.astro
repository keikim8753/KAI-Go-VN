---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyCard from '../CompanyCard.astro';
import { t, type Locale } from '../../lib/i18n';
import { SECTORS, sectorLabel } from '../../lib/sectors';
import { getPublicCompanies } from '../../lib/companies';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const companies = await getPublicCompanies(locale);
const highlighted = companies.slice(0, 3);
---

<BaseLayout locale={locale} title={t(locale, 'nav_home')} currentPath="/">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>{t(locale, 'hero_title')}</h1>
        <p>{t(locale, 'hero_desc')}</p>
        <a class="btn btn-primary" href={`${base}/${locale}/directory`}>{t(locale, 'sector_view_all')} →</a>
      </div>
      <div class="hero-card">
        <div class="segmented-tabs">
          {SECTORS.slice(0, 4).map((s, i) => (
            <a class={i === 0 ? 'active' : ''} href={`${base}/${locale}/sector/${s}`}>{sectorLabel(s, locale)}</a>
          ))}
        </div>
        <div class="stat-grid">
          <div class="stat-cell"><div class="value">66+</div><div class="label">Companies</div></div>
          <div class="stat-cell"><div class="value">7</div><div class="label">Sectors</div></div>
          <div class="stat-cell"><div class="value">NIPA</div><div class="label">Supported</div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="grid-cards">
      {SECTORS.map((sector) => (
        <a class="glass-card" style="padding: 1rem 1.25rem; text-decoration: none; color: var(--text-high); font-size: 0.9rem;" href={`${base}/${locale}/sector/${sector}`}>
          {sectorLabel(sector, locale)}
        </a>
      ))}
    </div>
  </section>

  {highlighted.length > 0 && (
    <section class="section container">
      <div class="grid-cards">
        {highlighted.map((company) => (
          <CompanyCard locale={locale} company={company} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
