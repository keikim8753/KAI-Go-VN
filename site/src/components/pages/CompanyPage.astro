---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PdfViewer from '../PdfViewer.astro';
import { t, type Locale } from '../../lib/i18n';
import { sectorLabel, type Sector } from '../../lib/sectors';
import { sdgLabel } from '../../lib/sdgs';
import type { PublicCompany } from '../../lib/companies';

interface Props {
  locale: Locale;
  company: PublicCompany;
}

const { locale, company } = Astro.props;
const inquiryMailto = `mailto:hcmc@nipa.kr?subject=${encodeURIComponent(
  `[${company.name}] Matching Inquiry`,
)}`;
const publishedDocs = (company.pdf_documents ?? []).filter((d) => d.is_published);
// 파일럿/예시 데이터에 example.com 같은 placeholder URL이 남아있을 수 있어, 실제 링크처럼
// 클릭되지 않도록 방문자에게 "준비 중"으로 표시한다 (README 파일럿 데이터 교체 전 안전장치).
const isPlaceholderWebsite = /(^|\.)example\.com$/.test(
  (() => {
    try {
      return new URL(company.official_website).hostname;
    } catch {
      return '';
    }
  })(),
);
---

<BaseLayout locale={locale} title={company.name} currentPath={`/company/${company.company_id}`}>
  <div class="container">
    <!-- ① 히어로 -->
    <header style="display:flex; gap:1.5rem; align-items:center; padding: 2rem 0;">
      {company.logo_image && (
        <img src={company.logo_image} alt={`${company.name} logo`} style="width:88px;height:88px;object-fit:contain;border-radius:16px;background:var(--bg-elev);flex-shrink:0;" />
      )}
      <div>
        <div class="card-badges" style="margin-bottom:0.5rem;">
          <span class="badge">{sectorLabel(company.sector as Sector, locale)}</span>
          {company.events?.map((e) => <span class="badge">{e.name} · {e.date}</span>)}
        </div>
        <h1 style="margin:0 0 0.4rem; font-size:1.6rem;">{company.name}</h1>
        <p style="margin:0; color:var(--text-mid);">{company.tagline}</p>
      </div>
    </header>

    <!-- ② 문제 -->
    <section class="section">
      <h2>{t(locale, 'section_problem')}</h2>
      <p>{company.problem}</p>
    </section>

    <!-- ③ 해결과 가치 -->
    <section class="section">
      <h2>{t(locale, 'section_value')}</h2>
      <p style="white-space: pre-line;">{company.value_summary}</p>
      {company.key_metrics?.length > 0 && (
        <div class="stat-grid">
          {company.key_metrics.map((m) => (
            <div class="stat-cell">
              <div class="value">{m.value}</div>
              <div class="label">{m.label}</div>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- ④ 베트남 적용 -->
    <section class="section">
      <h2>{t(locale, 'section_vietnam_fit')}</h2>
      <p>{company.vietnam_fit}</p>
      {company.sdgs?.length > 0 && (
        <div class="card-badges">
          {company.sdgs.map((n) => <span class="badge">SDG {n} · {sdgLabel(n, locale)}</span>)}
        </div>
      )}
    </section>

    <!-- ⑤ 자료실 -->
    {publishedDocs.length > 0 && (
      <section class="section">
        <h2>{t(locale, 'section_documents')}</h2>
        <PdfViewer locale={locale} documents={publishedDocs} />
      </section>
    )}

    <!-- ⑥ 희망 협력분야 -->
    <section class="section">
      <h2>{t(locale, 'section_target_buyer')}</h2>
      <p>{company.target_buyer_display}</p>
    </section>

    <!-- ⑦ CTA -->
    <section class="section" style="display:flex; gap:0.75rem; flex-wrap:wrap;">
      {isPlaceholderWebsite ? (
        <span class="btn btn-secondary" style="cursor:default; opacity:0.6;">{t(locale, 'website_pending')}</span>
      ) : (
        <a class="btn btn-primary" href={company.official_website} target="_blank" rel="noopener noreferrer">
          {t(locale, 'cta_website')}
        </a>
      )}
      <a class="btn btn-secondary" href={inquiryMailto}>{t(locale, 'cta_inquiry')}</a>
    </section>
  </div>
</BaseLayout>
