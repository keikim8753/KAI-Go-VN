---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, type Locale } from '../../lib/i18n';
import { SECTORS, sectorLabel } from '../../lib/sectors';
import { getPublicCompanies } from '../../lib/companies';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const companies = await getPublicCompanies(locale);
const sdgOptions = [...new Set(companies.flatMap((c) => c.sdgs ?? []))].sort((a, b) => a - b);
---

<BaseLayout locale={locale} title={t(locale, 'nav_directory')} currentPath="/directory">
  <div class="container">
    <h1 style="font-size:1.4rem; margin-top:2rem;">{t(locale, 'nav_directory')}</h1>

    <div class="filters">
      <select id="filter-sector">
        <option value="">{t(locale, 'directory_filter_sector')}: {t(locale, 'directory_filter_all')}</option>
        {SECTORS.map((s) => <option value={s}>{sectorLabel(s, locale)}</option>)}
      </select>
      <select id="filter-sdg">
        <option value="">{t(locale, 'directory_filter_sdg')}: {t(locale, 'directory_filter_all')}</option>
        {sdgOptions.map((n) => <option value={n}>SDG {n}</option>)}
      </select>
      <label class="event-check">
        <input type="checkbox" id="filter-event" />
        {t(locale, 'directory_filter_event')}
      </label>
    </div>

    <div class="grid-cards" id="results" style="margin-top:1.5rem;"></div>
    <p id="no-results" hidden style="color:var(--text-mid);">{t(locale, 'directory_no_results')}</p>
  </div>

  <script type="application/json" id="companies-data" set:html={JSON.stringify(companies)} />
  <script define:vars={{ locale, base }}>
    const data = JSON.parse(document.getElementById('companies-data').textContent);
    const resultsEl = document.getElementById('results');
    const noResultsEl = document.getElementById('no-results');
    const sectorSelect = document.getElementById('filter-sector');
    const sdgSelect = document.getElementById('filter-sdg');
    const eventCheck = document.getElementById('filter-event');

    function cardHtml(company) {
      const logo = company.logo_image
        ? `<img class="logo" src="${company.logo_image}" alt="" loading="lazy" />`
        : '';
      const metric = company.key_metrics?.[0];
      const metricHtml = metric
        ? `<p class="tagline"><strong style="color:var(--accent)">${metric.value}</strong> ${metric.label}</p>`
        : '';
      const badges = [
        ...(company.events ?? []).map((e) => `<span class="badge">${e.name}</span>`),
        ...(company.sdgs ?? []).slice(0, 3).map((n) => `<span class="badge">SDG ${n}</span>`),
      ].join('');
      return `
        <a class="glass-card company-card" href="${base}/${locale}/company/${company.company_id}">
          ${logo}
          <div class="body">
            <h3>${company.name}</h3>
            <p class="tagline">${company.tagline}</p>
            ${metricHtml}
            <div class="card-badges">${badges}</div>
          </div>
        </a>
      `;
    }

    function render() {
      const sector = sectorSelect.value;
      const sdg = sdgSelect.value ? Number(sdgSelect.value) : null;
      const eventOnly = eventCheck.checked;

      const filtered = data.filter((c) => {
        if (sector && c.sector !== sector) return false;
        if (sdg && !(c.sdgs ?? []).includes(sdg)) return false;
        if (eventOnly && !(c.events ?? []).length) return false;
        return true;
      });

      resultsEl.innerHTML = filtered.map(cardHtml).join('');
      noResultsEl.hidden = filtered.length > 0;
    }

    [sectorSelect, sdgSelect, eventCheck].forEach((el) => el.addEventListener('change', render));
    render();
  </script>

  <style>
    .filters {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin: 1.5rem 0;
      align-items: center;
    }
    .filters select {
      padding: 0.5rem 0.75rem;
      border-radius: 10px;
      border: 1px solid var(--glass-border);
      background: var(--bg-elev);
      color: var(--text-high);
      font-size: 0.85rem;
      font-family: inherit;
    }
    .event-check {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
      color: var(--text-mid);
    }
  </style>
</BaseLayout>
