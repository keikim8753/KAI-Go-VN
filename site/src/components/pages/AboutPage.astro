---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout locale={locale} title={t(locale, 'about_title')} currentPath="/about">
  <h1>{t(locale, 'about_title')}</h1>
  <p>{t(locale, 'about_body')}</p>
  <p>
    <a href="mailto:hcmc@nipa.kr">{t(locale, 'about_contact')}</a>
  </p>
</BaseLayout>
