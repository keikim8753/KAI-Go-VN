---
import CompanyPage from '../../../components/pages/CompanyPage.astro';
import { getAllPublicCompanyIds, getPublicCompany } from '../../../lib/companies';

export async function getStaticPaths() {
  const ids = await getAllPublicCompanyIds('vi');
  return ids.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const company = (await getPublicCompany('vi', id!))!;
---
<CompanyPage locale="vi" company={company} />
